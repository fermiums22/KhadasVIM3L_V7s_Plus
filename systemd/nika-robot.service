[Unit]
Description=Nika Khadas ROS diagnostics and MQTT bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=/etc/nika-robot/robot.env
ConditionPathExists=/etc/nika-robot/mqtt-password

[Service]
Type=simple
User=nika-robot
Group=nika-robot
EnvironmentFile=/etc/nika-robot/robot.env
Environment=ROS_LOG_DIR=/var/lib/nika-robot/log
ExecStart=/opt/nika-robot/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
StateDirectory=nika-robot
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
